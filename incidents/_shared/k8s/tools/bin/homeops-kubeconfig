#!/bin/sh
# Точка входа образа: собственный kubeconfig контейнера поверх общего из тома кластера.
# KUBECONFIG=~/.kube/config:/kube/config — доступ к кластеру всегда из свежего /kube/config
# (кластер пересоздаётся с новыми сертификатами), а контекст с namespace стенда — в своём файле.
mkdir -p "$HOME/.kube"
if [ ! -f "$HOME/.kube/config" ]; then
  cat > "$HOME/.kube/config" <<CFG
apiVersion: v1
kind: Config
current-context: homeops
contexts:
- name: homeops
  context:
    cluster: kind-${KIND_CLUSTER_NAME:-homeops}
    user: kind-${KIND_CLUSTER_NAME:-homeops}
    namespace: ${K8S_NAMESPACE:-default}
CFG
  chmod 600 "$HOME/.kube/config"
fi
exec "$@"
